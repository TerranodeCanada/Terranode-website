// Receipt filing: register metadata in the private Operations Hub; keep originals in Drive.
const EXPENSE_HEADERS=['Receipt ID','Filed at','Expense date','Destination','Project','Category','Vendor','Amount','Currency','File name','File URL','Drive file ID','Source','Sender','Email subject','Email URL','Status','Notes','Source key'];
const EXPENSE_MAX_BYTES=12*1024*1024,EXPENSE_EMAIL_LABEL='Invoice';
function expenseSheet_(){
 const book=hub_();let sheet=book.getSheetByName('Expense Register');
 if(!sheet){sheet=book.insertSheet('Expense Register');sheet.getRange(1,1,1,EXPENSE_HEADERS.length).setValues([EXPENSE_HEADERS]);sheet.setFrozenRows(1);sheet.setRowHeight(1,38);sheet.getRange(1,1,1,EXPENSE_HEADERS.length).setBackground('#26352F').setFontColor('#F5F2E9').setFontWeight('bold').setWrap(true);[120,145,115,135,200,165,190,105,85,260,130,150,120,220,230,230,135,260,280].forEach((w,i)=>sheet.setColumnWidth(i+1,w));sheet.getRange(2,8,Math.max(1,sheet.getMaxRows()-1),1).setNumberFormat('#,##0.00');sheet.getRange(2,2,Math.max(1,sheet.getMaxRows()-1),1).setNumberFormat('yyyy-mm-dd hh:mm');sheet.getRange(2,3,Math.max(1,sheet.getMaxRows()-1),1).setNumberFormat('yyyy-mm-dd');sheet.hideColumns(12);sheet.hideColumns(19);sheet.getRange(1,1,sheet.getMaxRows(),18).createFilter();}
 const actual=sheet.getRange(1,1,1,EXPENSE_HEADERS.length).getValues()[0].map(text_);if(actual.join('|')!==EXPENSE_HEADERS.join('|'))throw new Error('Expense Register columns do not match. No changes were made.');return sheet;
}
function expenseFinanceFolder_(name){const matches=[],it=DriveApp.getFoldersByName(name);while(it.hasNext()){const folder=it.next(),parents=folder.getParents();while(parents.hasNext())if(parents.next().getName().trim()==='03 — Money & Legal'){matches.push(folder);break;}}if(matches.length!==1)throw new Error('The private '+name+' folder could not be identified uniquely under 03 — Money & Legal.');return matches[0];}
function expenseProjects_(){return projects_().filter(p=>!/^template\b/i.test(p.name));}
function expenseProjectFolder_(id){const project=expenseProjects_().find(p=>p.id===text_(id));if(!project)throw new Error('Choose an existing project.');const parent=DriveApp.getFolderById(project.id),it=parent.getFoldersByName('Invoices & Receipts');if(it.hasNext()){const folder=it.next();if(it.hasNext())throw new Error('More than one Invoices & Receipts folder exists in this project.');return {folder,project};}return {folder:parent.createFolder('Invoices & Receipts'),project};}
function expenseTarget_(kind,id){if(kind==='company')return {folder:expenseFinanceFolder_('Company Expenses'),project:null,label:'Company expense'};if(kind==='project'){const route=expenseProjectFolder_(id);return {folder:route.folder,project:route.project,label:'Project expense'};}throw new Error('Choose Project expense or Company expense.');}
function expenseCategory_(value){const v=text_(value).trim();if(!['Materials & supplies','Products & equipment','Software & subscriptions','Travel','Other','Uncategorized'].includes(v))throw new Error('Choose an expense category.');return v;}
function expenseDate_(value){if(!value)return '';if(value instanceof Date&&!isNaN(value.getTime()))return value;const m=text_(value).match(/^(\d{4})-(\d{2})-(\d{2})$/);if(!m)throw new Error('Enter a valid expense date.');const d=new Date(+m[1],+m[2]-1,+m[3]);if(d.getFullYear()!==+m[1]||d.getMonth()!==+m[2]-1||d.getDate()!==+m[3])throw new Error('Enter a valid expense date.');return d;}
function expenseAmount_(value){if(value==null||text_(value).trim()==='')return '';const n=Number(value);if(!isFinite(n)||n<0||n>100000000)throw new Error('Enter an amount from 0 to 100,000,000.');return n;}
function expenseFileType_(name,mime){const ext=(text_(name).match(/\.([a-z0-9]+)$/i)||[])[1],type=text_(mime).toLowerCase();return !!ext&&['pdf','jpg','jpeg','png','webp','heic','heif'].includes(ext.toLowerCase())&&(type==='application/pdf'||type.indexOf('image/')===0||type==='application/octet-stream'||!type);}
function expenseDigest_(bytes){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function expenseRowForKey_(sheet,key){const n=sheet.getLastRow();if(n<2)return 0;const f=sheet.getRange(2,19,n-1,1).createTextFinder(text_(key)).matchEntireCell(true).findNext();return f?f.getRow():0;}
function expenseRecord_(v){return {id:text_(v[0]),filedAt:v[1] instanceof Date?v[1].toISOString():text_(v[1]),expenseDate:v[2] instanceof Date?Utilities.formatDate(v[2],Session.getScriptTimeZone(),'yyyy-MM-dd'):text_(v[2]),destination:text_(v[3]),project:text_(v[4]),category:text_(v[5]),vendor:text_(v[6]),amount:text_(v[7]),currency:text_(v[8]),fileName:text_(v[9]),fileUrl:text_(v[10]),source:text_(v[12]),sender:text_(v[13]),emailSubject:text_(v[14]),emailUrl:text_(v[15]),status:text_(v[16]),notes:text_(v[17])};}
function expenseRow_(sheet,n){return expenseRecord_(sheet.getRange(n,1,1,19).getValues()[0]);}
function expenseAlert_(key,r,note){return enqueueWorkspaceAlert_({key:'workspace:expense:'+key,type:'Receipt filed',recordId:r.id,url:r.fileUrl,details:{source:r.source,project:r.project,filename:r.fileName,sourceUrl:r.emailUrl,note:note||'A receipt was filed in the Operations Hub.'}});}
function expenseCreate_(data){const sheet=expenseSheet_(),prior=expenseRowForKey_(sheet,data.sourceKey);if(prior)return {record:expenseRow_(sheet,prior),duplicate:true};const id='EXP-'+Utilities.getUuid().replace(/-/g,'').slice(0,10).toUpperCase(),name=text_(data.filename).trim().slice(0,250)||'Receipt',file=data.folder.createFile(data.blob.setName(name));file.setDescription(['Terranode expense receipt','Receipt ID: '+id,'Original filename: '+name,'Source key: '+data.sourceKey].join('\n'));const row=[id,new Date(),data.expenseDate||'',data.destination,data.project||'',data.category||'Uncategorized',safeCell_(data.vendor||''),data.amount===''?'':data.amount,data.currency||'',safeCell_(name),file.getUrl(),file.getId(),data.source||'Manual upload',safeCell_(data.sender||''),safeCell_(data.subject||''),data.emailUrl||'',data.status||'Filed',safeCell_(data.notes||''),data.sourceKey];try{sheet.appendRow(row);}catch(error){try{file.moveTo(expenseFinanceFolder_('Receipts to review'));}catch(_){}throw new Error('The original was saved in Receipts to review, but the register could not be updated. Refresh and check before retrying.');}return {record:expenseRecord_(row),duplicate:false};}
function getExpenseFilingState(){checkWebUser_();const sheet=expenseSheet_(),last=sheet.getLastRow(),start=Math.max(2,last-99),rows=last>=2?sheet.getRange(start,1,last-start+1,19).getValues():[],props=PropertiesService.getScriptProperties();return {records:rows.reverse().map(expenseRecord_),projects:expenseProjects_().map(p=>({id:p.id,name:p.name,group:p.group,url:p.url})),emailEnabled:!!props.getProperty('expenseEmailCutover'),emailError:props.getProperty('expenseEmailLastError')||'',emailLabel:EXPENSE_EMAIL_LABEL,registerUrl:'https://docs.google.com/spreadsheets/d/'+T.hub+'/edit#gid='+sheet.getSheetId(),companyFolderUrl:expenseFinanceFolder_('Company Expenses').getUrl(),reviewFolderUrl:expenseFinanceFolder_('Receipts to review').getUrl(),updatedAt:now_()};}
function saveExpenseReceipt(input){checkWebUser_();const lock=LockService.getScriptLock();lock.waitLock(30000);try{const d=input||{},req=text_(d.requestId).trim();if(!/^[a-z0-9:_-]{8,100}$/i.test(req))throw new Error('Refresh the page and try again.');const key='manual:'+req,sheet=expenseSheet_(),prior=expenseRowForKey_(sheet,key);if(prior)return {saved:true,duplicate:true,record:expenseRow_(sheet,prior),notification:'Already filed'};const name=text_(d.filename).trim().slice(0,250),mime=text_(d.mime).toLowerCase(),encoded=text_(d.base64);if(!name||!encoded||encoded.length>Math.ceil(EXPENSE_MAX_BYTES*4/3)+16||!expenseFileType_(name,mime))throw new Error('Choose a PDF or receipt photo up to 12 MB.');const bytes=Utilities.base64Decode(encoded);if(!bytes.length||bytes.length>EXPENSE_MAX_BYTES)throw new Error('Choose a file from 1 byte to 12 MB.');const target=expenseTarget_(text_(d.destination),text_(d.projectId)),date=expenseDate_(d.expenseDate),category=expenseCategory_(d.category),amount=expenseAmount_(d.amount),currency=amount===''?'':text_(d.currency).toUpperCase();if(currency&&!['CAD','USD','EUR','GBP'].includes(currency))throw new Error('Choose CAD, USD, EUR, or GBP.');const vendor=text_(d.vendor).trim().slice(0,180),notes=text_(d.notes).trim().slice(0,1000),created=expenseCreate_({sourceKey:key,blob:Utilities.newBlob(bytes,mime,name),filename:name,folder:target.folder,destination:target.label,project:target.project?target.project.name:'',category,vendor,amount,currency,expenseDate:date,source:'Manual upload',status:'Filed',notes}),notification=expenseAlert_(req,created.record,'Category: '+category+(vendor?' · Vendor: '+vendor:'')+(amount!==''?' · Amount: '+currency+' '+amount:''));return {saved:true,duplicate:created.duplicate,record:created.record,notification:notification.status};}finally{invalidateWorkspaceSnapshots_();lock.releaseLock();}}
function resolveExpenseReceipt(receiptId,kind,projectId,category){checkWebUser_();const lock=LockService.getScriptLock();lock.waitLock(30000);try{const sheet=expenseSheet_(),last=sheet.getLastRow();if(last<2)throw new Error('This receipt is no longer waiting for review. Refresh the list.');const found=sheet.getRange(2,1,last-1,1).createTextFinder(text_(receiptId)).matchEntireCell(true).findNext();if(!found)throw new Error('This receipt is no longer in the register. Refresh the list.');const row=found.getRow(),old=sheet.getRange(row,1,1,19).getValues()[0];if(text_(old[16])!=='Needs review')return {saved:true,record:expenseRecord_(old),duplicate:true};const target=expenseTarget_(kind,projectId),chosen=expenseCategory_(category);DriveApp.getFileById(text_(old[11])).moveTo(target.folder);sheet.getRange(row,4,1,3).setValues([[target.label,target.project?target.project.name:'',chosen]]);sheet.getRange(row,17).setValue('Filed');const record=expenseRow_(sheet,row),notice=expenseAlert_('review:'+receiptId,record,'Category: '+chosen);return {saved:true,record,notification:notice.status};}finally{invalidateWorkspaceSnapshots_();lock.releaseLock();}}
function expenseNormalize_(value){return text_(value).toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();}
function expenseMatchProject_(value,projects){const text=' '+expenseNormalize_(value)+' ',found=projects.filter(p=>{const name=expenseNormalize_(p.name);return name&&text.indexOf(' '+name+' ')>=0;});return found.length===1?found[0]:null;}
function processExpenseReceiptEmails(){checkOwner_();const props=PropertiesService.getScriptProperties(),cutover=Number(props.getProperty('expenseEmailCutover')||0);if(!cutover)return {processed:0,needsReview:0,enabled:false};const lock=LockService.getScriptLock();lock.waitLock(30000);let processed=0,needsReview=0,errors=0;try{if(!GmailApp.getUserLabelByName(EXPENSE_EMAIL_LABEL))throw new Error('Gmail label “Invoice” was not found. Restore it, then try again.');const after=Utilities.formatDate(new Date(cutover),Session.getScriptTimeZone(),'yyyy/MM/dd'),threads=GmailApp.search('label:'+EXPENSE_EMAIL_LABEL+' has:attachment after:'+after,0,100),sheet=expenseSheet_(),projects=expenseProjects_();threads.forEach(thread=>{const saved=[];thread.getMessages().forEach(message=>{if(message.getDate().getTime()<=cutover)return;message.getAttachments({includeInlineImages:false,includeAttachments:true}).forEach(attachment=>{try{const name=text_(attachment.getName()).trim(),mime=text_(attachment.getContentType()).toLowerCase(),bytes=attachment.getBytes();if(!name||!bytes.length||bytes.length>EXPENSE_MAX_BYTES||!expenseFileType_(name,mime))return;const key='gmail:'+message.getId()+':'+expenseDigest_(bytes);if(expenseRowForKey_(sheet,key))return;const project=expenseMatchProject_(message.getSubject()+' '+name,projects),review=!project,target=review?{folder:expenseFinanceFolder_('Receipts to review'),project:null,label:'Needs review'}:expenseTarget_('project',project.id),from=text_(message.getFrom()).slice(0,250),subject=text_(message.getSubject()).slice(0,500),url='https://mail.google.com/mail/u/0/#all/'+thread.getId(),created=expenseCreate_({sourceKey:key,blob:Utilities.newBlob(bytes,mime,name),filename:name,folder:target.folder,destination:target.label,project:target.project?target.project.name:'',category:'Uncategorized',vendor:'',amount:'',currency:'',expenseDate:'',source:'Email attachment',sender:from,subject,emailUrl:url,status:review?'Needs review':'Filed',notes:review?'Choose a project or company destination.':''});if(!created.duplicate){processed++;if(review)needsReview++;saved.push(created.record);}}catch(error){errors++;console.error('Receipt attachment could not be filed: '+text_(error.message).slice(0,300));}});});if(saved.length)enqueueWorkspaceAlert_({key:'workspace:expense-email:'+expenseDigest_(Utilities.newBlob(thread.getId()).getBytes()),type:'Receipt email filed',recordId:saved.map(r=>r.id).join(', '),url:saved[0].fileUrl,details:{source:'Email receipt',filename:saved.map(r=>r.fileName).join(', '),fileSummary:saved.length+' receipt attachment(s) filed',sourceUrl:'https://mail.google.com/mail/u/0/#all/'+thread.getId(),note:'Receipt email processed.'}});});props.setProperty('expenseEmailLastCheck',String(Date.now()));props.deleteProperty('expenseEmailLastError');return {processed,needsReview,errors,enabled:true};}catch(error){props.setProperty('expenseEmailLastError',text_(error.message).slice(0,500));throw error;}finally{invalidateWorkspaceSnapshots_();lock.releaseLock();}}
function enableExpenseEmailFiling(){checkWebUser_();if(!GmailApp.getUserLabelByName(EXPENSE_EMAIL_LABEL))throw new Error('Gmail label “Invoice” was not found. Create or restore it, then try again.');const props=PropertiesService.getScriptProperties(),triggers=ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='processExpenseReceiptEmails');if(!triggers.length)ScriptApp.newTrigger('processExpenseReceiptEmails').timeBased().everyMinutes(10).create();if(!props.getProperty('expenseEmailCutover'))props.setProperty('expenseEmailCutover',String(Date.now()));props.deleteProperty('expenseEmailLastError');return {enabled:true};}
function checkExpenseEmailNow(){checkWebUser_();return processExpenseReceiptEmails();}
function disableExpenseEmailFiling(){checkWebUser_();ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='processExpenseReceiptEmails').forEach(t=>ScriptApp.deleteTrigger(t));const props=PropertiesService.getScriptProperties();props.deleteProperty('expenseEmailCutover');props.deleteProperty('expenseEmailLastError');return {enabled:false};}

function authorizeWorkspaceEmailAlerts(){ checkWebUser_(); return {emailAlertsAuthorized:true, remainingQuota:MailApp.getRemainingDailyQuota()}; }